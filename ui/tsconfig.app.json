{
  "extends": "@moonstar-x/tsconfig/react",
  "include": [
    "src"
  ],

  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],

    "paths": {
      "@components/*": ["./src/components/*"],
      "@core/*": ["./src/core/*"],
      "@pages/*": ["./src/pages/*"],
      "@services/*": ["./src/services/*"],
      "@styles/*": ["./src/styles/*"]
    }
  }
}
