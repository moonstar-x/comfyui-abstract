{
  "extends": "@moonstar-x/tsconfig/node",
  "include": [
    "vite.config.ts"
  ],

  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "noEmit": true,
    // @rolldown/plugin-babel types reference Babel 8 members that @types/babel__core (Babel 7) does not have.
    "skipLibCheck": true
  }
}
