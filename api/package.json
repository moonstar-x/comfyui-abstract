  "dependencies": {
    "@moonstar-x/logger": "^2.0.0",
    "@saintno/comfyui-sdk": "^0.3.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.12",
    "on-finished": "^2.4.1",
    "pg-promise": "^12.7.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@moonstar-x/eslint-config": "^2.0.0",
    "@moonstar-x/tsconfig": "^1.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/on-finished": "^2.3.5",
    "@types/ws": "^8.18.2",
